---
import { photoSources, type PhotoCategory } from "../../data/photos";
import Layout from "../../layouts/Layout.astro";
import { optimizePhotoSources } from "../../lib/photo-images";

const photos = await optimizePhotoSources(photoSources);

const sections: {
  description: string;
  id: PhotoCategory;
  title: string;
}[] = [
  {
    id: "people",
    title: "People",
    description: "Characters, gestures, and the moments around them.",
  },
  {
    id: "landscape",
    title: "Landscape",
    description: "Places, architecture, and the spaces between.",
  },
  {
    id: "creative",
    title: "Creative",
    description: "Art, material, and experiments that catch my eye.",
  },
];

const placementClasses: Record<PhotoCategory, string[]> = {
  people: ["sm:w-[72%]"],
  landscape: ["", "sm:ml-auto sm:w-[66%]"],
  creative: ["sm:ml-auto sm:w-[78%]"],
};
---

<Layout
  title="Photos"
  description="Photography by Piotr Kazala: people, landscapes, and creative work."
>
  <main class="pb-14 sm:pb-20">
    <section class="pt-10 sm:pt-14" aria-labelledby="photos-page-title">
      <h1
        id="photos-page-title"
        class="text-3xl font-medium tracking-[-0.025em] text-ink"
      >
        Photographs
      </h1>
      <p class="mt-3 max-w-xl text-lg leading-8 text-muted">
        People, places, and small visual experiments. Four frames for now, with
        more to come.
      </p>
      <nav class="mt-6 flex flex-wrap gap-2" aria-label="Photo categories">
        {
          sections.map((section) => (
            <a
              class="rounded-full border border-ink/10 bg-white/60 px-3 py-1.5 text-sm text-zinc-700 transition-colors duration-150 ease-out hover:border-ink/20 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/20 focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
              href={`#${section.id}`}
            >
              {section.title}
            </a>
          ))
        }
      </nav>
    </section>

    {
      sections.map((section, sectionIndex) => {
        const sectionPhotos = photos.filter(
          (photo) => photo.category === section.id,
        );

        return (
          <section
            id={section.id}
            class="grid scroll-mt-8 gap-6 pt-16 sm:grid-cols-[120px_1fr] sm:pt-20"
            aria-labelledby={`${section.id}-title`}
          >
            <div>
              <p class="font-mono text-xs text-muted" aria-hidden="true">
                {String(sectionIndex + 1).padStart(2, "0")}
              </p>
              <h2
                id={`${section.id}-title`}
                class="mt-2 text-lg font-medium text-ink"
              >
                {section.title}
              </h2>
              <p class="mt-2 text-sm leading-6 text-muted">
                {section.description}
              </p>
            </div>

            <div class="space-y-4 sm:space-y-5">
              {sectionPhotos.map((photo, photoIndex) => (
                <figure class={placementClasses[section.id][photoIndex] ?? ""}>
                  <picture>
                    <source
                      srcset={photo.avifSrcSet}
                      sizes="(min-width: 640px) 544px, calc(100vw - 32px)"
                      type="image/avif"
                    />
                    <source
                      srcset={photo.webpSrcSet}
                      sizes="(min-width: 640px) 544px, calc(100vw - 32px)"
                      type="image/webp"
                    />
                    <img
                      class="h-auto w-full rounded-sm bg-zinc-100 object-cover"
                      src={photo.src}
                      srcset={photo.webpSrcSet}
                      sizes="(min-width: 640px) 544px, calc(100vw - 32px)"
                      width={photo.width}
                      height={photo.height}
                      alt={photo.alt}
                      loading={sectionIndex === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </picture>
                </figure>
              ))}
            </div>
          </section>
        );
      })
    }
  </main>
</Layout>

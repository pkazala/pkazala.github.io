---
import { getCollection } from "astro:content";
import EuropeGlobe from "../components/EuropeGlobe.astro";
import NowStatement from "../components/NowStatement.astro";
import PhotoLightbox from "../components/PhotoLightbox";
import Layout from "../layouts/Layout.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft || !import.meta.env.PROD)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);

const photos = [
  {
    src: "/photos/photo-01-960.webp",
    srcSet:
      "/photos/photo-01-480.webp 320w, /photos/photo-01-960.webp 640w, /photos/photo-01-1086.webp 724w",
    alt: "A photograph by Piotr Kazala.",
  },
  {
    src: "/photos/photo-02-960.webp",
    srcSet:
      "/photos/photo-02-480.webp 480w, /photos/photo-02-960.webp 960w, /photos/photo-02-1086.webp 1086w",
    alt: "A photograph by Piotr Kazala.",
  },
  {
    src: "/photos/photo-03-960.webp",
    srcSet:
      "/photos/photo-03-480.webp 320w, /photos/photo-03-960.webp 640w, /photos/photo-03-1086.webp 724w",
    alt: "A photograph by Piotr Kazala.",
  },
  {
    src: "/photos/photo-04-960.webp",
    srcSet:
      "/photos/photo-04-480.webp 480w, /photos/photo-04-960.webp 960w, /photos/photo-04-1086.webp 1086w",
    alt: "A photograph by Piotr Kazala.",
  },
];
---

<Layout
  title="Piotr Kazala"
  description="Personal website of Piotr Kazala, a software engineer in Edinburgh."
>
  <main>
    <section class="pt-10 sm:pt-16" aria-labelledby="intro-title">
      <p class="mb-5 font-mono text-sm text-muted">
        software engineer / edinburgh
      </p>
      <h1
        id="intro-title"
        class="text-5xl font-semibold leading-[1.05] tracking-normal text-ink sm:text-6xl"
      >
        Piotr Kazala
      </h1>
      <div class="mt-6">
        <NowStatement />
      </div>
    </section>

    <EuropeGlobe />

    <section
      class="grid gap-4 border-b border-ink/10 py-10 sm:grid-cols-[160px_1fr]"
      aria-labelledby="writing-title"
    >
      <div>
        <h2 id="writing-title" class="text-sm font-medium text-muted">
          Writing
        </h2>
        <a
          class="mt-2 inline-block text-sm text-muted underline underline-offset-4"
          href="/blog/"
        >
          All posts
        </a>
      </div>
      <div class="space-y-5">
        {
          posts.map((post) => (
            <a class="group block" href={`/blog/${post.slug}/`}>
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-medium text-ink group-hover:underline group-hover:underline-offset-4">
                  {post.data.title}
                </h3>
                <time
                  class="font-mono text-xs text-muted"
                  datetime={post.data.date.toISOString()}
                >
                  {formatDate(post.data.date)}
                </time>
              </div>
              <p class="mt-1 text-sm leading-6 text-muted">
                {post.data.description}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <section
      id="photos"
      class="grid gap-4 border-b border-ink/10 py-10 sm:grid-cols-[160px_1fr]"
      aria-labelledby="photos-title"
    >
      <h2 id="photos-title" class="text-sm font-medium text-muted">Photos</h2>
      <div class="space-y-4">
        <PhotoLightbox photos={photos} client:load />
        <p class="font-mono text-xs text-muted">
          Optimized local WebP photos.
        </p>
      </div>
    </section>

    <section
      id="contact"
      class="grid gap-4 py-10 sm:grid-cols-[160px_1fr]"
      aria-labelledby="contact-title"
    >
      <h2 id="contact-title" class="text-sm font-medium text-muted">
        Elsewhere
      </h2>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a
          class="text-zinc-700 underline underline-offset-4 hover:text-ink"
          href="https://github.com/pkazala"
        >
          GitHub
        </a>
        <a
          class="text-zinc-700 underline underline-offset-4 hover:text-ink"
          href="https://www.linkedin.com/in/piotrkazala/"
        >
          LinkedIn
        </a>
        <a
          class="text-zinc-700 underline underline-offset-4 hover:text-ink"
          href="/blog/"
        >
          Blog
        </a>
      </div>
    </section>
  </main>
</Layout>

---
import { getCollection } from "astro:content";
import EuropeGlobe from "../components/EuropeGlobe.astro";
import Layout from "../layouts/Layout.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft || !import.meta.env.PROD)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);

const facts = [
  "Software engineer at Aberdeen",
  "Previously Barclays, Aug 2024 - Apr 2026",
  "BSc Computer Science at Strathclyde",
  "Originally from Poland, living in Edinburgh",
];
---

<Layout
  title="Piotr Kazala"
  description="Personal website of Piotr Kazala, a software engineer in Edinburgh."
>
  <main>
    <section class="pt-10 sm:pt-16" aria-labelledby="intro-title">
      <p class="mb-5 font-mono text-sm text-muted">software engineer / edinburgh</p>
      <h1
        id="intro-title"
        class="text-5xl font-semibold leading-[1.05] tracking-normal text-ink sm:text-6xl"
      >
        Piotr Kazala
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-700">
        I build software at Aberdeen. Before that I worked at Barclays and
        studied Computer Science at Strathclyde.
      </p>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-700">
        I like clean systems, photography, LEGO, staying active, and beautiful
        things: design, architecture, literature, light. I also love my fiancee,
        my family cats, and the small rituals that make life feel warm.
      </p>
    </section>

    <EuropeGlobe />

    <section
      id="about"
      class="grid gap-4 border-b border-ink/10 pb-10 sm:grid-cols-[160px_1fr]"
    >
      <h2 class="text-sm font-medium text-muted">Now</h2>
      <ul class="space-y-2 text-zinc-700">
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </section>

    <section
      class="grid gap-4 border-b border-ink/10 py-10 sm:grid-cols-[160px_1fr]"
      aria-labelledby="writing-title"
    >
      <div>
        <h2 id="writing-title" class="text-sm font-medium text-muted">Writing</h2>
        <a class="mt-2 inline-block text-sm text-muted underline underline-offset-4" href="/blog/">
          All posts
        </a>
      </div>
      <div class="space-y-5">
        {
          posts.map((post) => (
            <a class="group block" href={`/blog/${post.slug}/`}>
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-medium text-ink group-hover:underline group-hover:underline-offset-4">
                  {post.data.title}
                </h3>
                <time class="font-mono text-xs text-muted" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
              </div>
              <p class="mt-1 text-sm leading-6 text-muted">{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section
      id="photos"
      class="grid gap-4 border-b border-ink/10 py-10 sm:grid-cols-[160px_1fr]"
      aria-labelledby="photos-title"
    >
      <h2 id="photos-title" class="text-sm font-medium text-muted">Photos</h2>
      <div>
        <p class="leading-8 text-zinc-700">
          A few favourite frames will live here soon. For now, this is a quiet
          placeholder for photography, places, and the people I love.
        </p>
        <p class="mt-3 font-mono text-xs text-muted">Drop images into public/photos.</p>
      </div>
    </section>

    <section
      id="contact"
      class="grid gap-4 py-10 sm:grid-cols-[160px_1fr]"
      aria-labelledby="contact-title"
    >
      <h2 id="contact-title" class="text-sm font-medium text-muted">Elsewhere</h2>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a class="text-zinc-700 underline underline-offset-4 hover:text-ink" href="https://github.com/pkazala">
          GitHub
        </a>
        <a class="text-zinc-700 underline underline-offset-4 hover:text-ink" href="/blog/">
          Blog
        </a>
      </div>
    </section>
  </main>
</Layout>

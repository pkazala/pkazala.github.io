---
import Visualization from "../layouts/Visualization.astro";

const title = "The geography of AI adoption";
const description =
  "Explore and compare estimated generative AI adoption across 147 economies. An interactive world map using Microsoft AI Economy Institute data for Q2 2026.";
const mapUrl = "https://world-data-ai-adoption.piotr-kazala.chatgpt.site/";
const imageAlt =
  "A dot map of estimated AI adoption across the world, colored blue for lower adoption and red for higher adoption. Global adoption is 18.8% of adults aged 15–64 in Q2 2026.";
---

<Visualization
  {title}
  {description}
  path="/ai-adoption/"
  imagePath="/images/ai-adoption-preview.png"
  {imageAlt}
  {mapUrl}
  mapTitle="Interactive AI adoption map with country comparisons"
/>

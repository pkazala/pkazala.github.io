---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Piotr Kazala",
  description = "Personal website of Piotr Kazala.",
} = Astro.props;

const pageTitle = title === "Piotr Kazala" ? title : `${title} | Piotr Kazala`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-[#fbfbfa] text-ink font-sans antialiased selection:bg-ink selection:text-white">
    <div class="mx-auto w-[min(100%-32px,680px)]">
      <header
        class="flex items-baseline justify-between gap-6 py-6 text-sm"
      >
        <a
          class="font-medium text-ink"
          href="/"
          aria-label="Piotr Kazala home"
        >
          <span>Piotr Kazala</span>
        </a>
        <nav
          class="flex items-center gap-4 text-muted"
          aria-label="Primary navigation"
        >
          <a
            class="hover:text-ink"
            href="/#about">About</a
          >
          <a class="hover:text-ink" href="/blog/">Blog</a>
          <a class="hover:text-ink" href="/#contact">Contact</a>
        </nav>
      </header>

      <slot />

      <footer
        class="mt-14 flex flex-wrap items-center justify-between gap-3 py-6 text-sm text-muted"
      >
        <p>Edinburgh, via Poland.</p>
        <p class="font-mono" aria-hidden="true">2026</p>
      </footer>
    </div>
  </body>
</html>
